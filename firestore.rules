rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The login flow looks up employeeCode before Firebase Auth sign-in.
    // Employee documents must never contain passwords or sensitive data.
    match /employees/{employeeId} {
      allow read: if true;
      allow create: if signedIn()
        && employeeId == request.auth.uid
        && request.resource.data.authUid == request.auth.uid;
      allow update: if signedIn() && employeeId == request.auth.uid;
      allow delete: if false;
    }

    match /tables/{tableId} {
      allow read, write: if signedIn();
    }

    match /foods/{foodId} {
      allow read, write: if signedIn();
    }

    match /orders/{orderId} {
      allow read, write: if signedIn();
    }

    match /invoices/{invoiceId} {
      allow read, write: if signedIn();
    }
  }
}
